# Copiar este archivo como .env y completar los valores.
# .env no se sube a git. En producción se pueden definir estas mismas
# variables directamente en el servidor en lugar de usar el archivo.

# ---- Formulario de contacto --------------------------------------------
# Casilla que recibe los mensajes del formulario.
CONTACT_TO_EMAIL=info@insalcor.com.uy
CONTACT_TO_NAME=Insalcor

# ---- SMTP --------------------------------------------------------------
# Gmail: smtp.gmail.com / 587 / tls, con una "contraseña de aplicación"
# (https://myaccount.google.com/apppasswords), 16 caracteres sin espacios.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# tls (puerto 587) o ssl (puerto 465)
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=

# Remitente del email. Si se deja vacío se usa SMTP_USER.
# Gmail y la mayoría de los servidores exigen que coincida con SMTP_USER.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Sitio web Insalcor
